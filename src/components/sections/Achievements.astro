---
import SectionHeading from '../ui/SectionHeading.astro';
import { achievements } from '../../data/achievements';

const featured    = achievements.filter(a => a.featured);
const nonFeatured = achievements.filter(a => !a.featured);
---

<section id="achievements" class="py-24 bg-[var(--bg-alt)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="anim fade-up">
      <SectionHeading overline="ACHIEVEMENTS" title="Recognition & Impact" />
    </div>

    <!-- Stat highlights -->
    <div class="flex flex-wrap gap-3 mb-8 anim fade-up" style="transition-delay: 50ms">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent-cyan/10 border border-accent-cyan/20 text-sm font-medium text-accent-cyan">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
        2x Spot Awards
      </span>
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent-violet/10 border border-accent-violet/20 text-sm font-medium text-accent-violet">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        1 Published Paper
      </span>
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent-teal/10 border border-accent-teal/20 text-sm font-medium text-accent-teal">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        SIH Finalist
      </span>
    </div>

    <!-- Featured achievement cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
      {featured.map((ach, i) => {
        const isLink = !!ach.link;
        const Tag = isLink ? 'a' : 'div';
        const linkProps = isLink ? { href: ach.link, target: '_blank', rel: 'noopener noreferrer' } : {};
        return (
          <Tag
            {...linkProps}
            class={`card p-6 relative overflow-hidden anim scale-in ${isLink ? 'hover:border-accent-cyan/40 cursor-pointer' : ''}`}
            style={`transition-delay: ${i * 100}ms`}
          >
            <!-- Gradient left border -->
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-accent-cyan to-accent-violet rounded-l-xl"></div>

            <div class="pl-2">
              <h3 class="font-display font-semibold text-[var(--text-primary)] text-sm leading-snug mb-1">
                {ach.title}
                {isLink && (
                  <svg class="inline w-3 h-3 ml-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </h3>
              <p class="text-xs text-accent-cyan font-mono mb-3">{ach.issuer}</p>
              <p class="text-xs text-[var(--text-secondary)] leading-relaxed">{ach.description}</p>
              <div class="mt-4">
                <span class="text-xs font-mono text-[var(--text-tertiary)]">{ach.year}</span>
              </div>
            </div>
          </Tag>
        );
      })}
    </div>

    <!-- Additional achievements list -->
    {nonFeatured.length > 0 && (
      <div class="card divide-y divide-[var(--border)] anim fade-up" style="transition-delay: 300ms">
        {nonFeatured.map(ach => (
          <div class="flex items-center gap-4 p-4 group hover:bg-[var(--bg-alt)] transition-colors rounded-xl">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-[var(--text-primary)] group-hover:text-accent-cyan transition-colors">{ach.title}</p>
              <p class="text-xs text-[var(--text-secondary)] mt-0.5 truncate">{ach.issuer}</p>
            </div>
            <span class="text-xs font-mono text-[var(--text-tertiary)] flex-shrink-0">{ach.year}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
