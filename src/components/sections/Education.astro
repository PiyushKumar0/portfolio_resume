---
import SectionHeading from '../ui/SectionHeading.astro';
import { education } from '../../data/education';
---

<section id="education" class="py-24 bg-[var(--bg-primary)]">
  <div class="max-w-3xl mx-auto px-6">
    <div class="anim fade-up">
      <SectionHeading overline="EDUCATION" title="Academic Background" />
    </div>

    {education.map(edu => (
      <div class="card p-8 anim scale-in flex flex-col sm:flex-row gap-6">
        <!-- Icon -->
        <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-accent-cyan/15 to-accent-violet/15 border border-[var(--border)] flex items-center justify-center text-2xl">
          🎓
        </div>
        <!-- Info -->
        <div class="flex-1">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
            <div>
              <h3 class="font-display font-semibold text-[var(--text-primary)]">
                {edu.degree} - {edu.field}
              </h3>
              <p class="text-sm text-accent-cyan mt-0.5">{edu.institution}</p>
              <p class="text-xs text-[var(--text-secondary)] mt-0.5">{edu.location}</p>
            </div>
            <span class="text-xs font-mono text-[var(--text-tertiary)] whitespace-nowrap">{edu.period}</span>
          </div>

          {edu.highlights && (
            <ul class="space-y-1.5 mt-4">
              {edu.highlights.map(h => (
                <li class="flex gap-2 text-sm text-[var(--text-secondary)]">
                  <span class="text-accent-cyan mt-1 flex-shrink-0">▹</span>
                  {h}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
