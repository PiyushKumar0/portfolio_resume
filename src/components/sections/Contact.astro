---
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="contact" class="py-24 bg-[var(--bg-alt)]">
  <div class="max-w-2xl mx-auto px-6 text-center">
    <div class="anim fade-up">
      <SectionHeading
        overline="GET IN TOUCH"
        title="Let's Build Something Together"
        subtitle="I'm open to new opportunities and interesting projects. Whether you have a question or just want to say hi, my inbox is always open."
        align="center"
      />
    </div>

    <!-- Contact buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center anim fade-up" style="transition-delay: 100ms">
      <a
        href="mailto:k.piyushkumar98@gmail.com"
        class="flex items-center justify-center gap-3 px-6 py-4 rounded-xl border border-[var(--border)] text-[var(--text-secondary)] hover:border-accent-cyan/40 hover:text-accent-cyan hover:bg-accent-cyan/5 transition-all duration-200 group"
      >
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <div class="text-left">
          <div class="text-xs text-[var(--text-tertiary)] font-mono uppercase tracking-wider mb-0.5">Email</div>
          <div class="text-sm font-medium">k.piyushkumar98@gmail.com</div>
        </div>
      </a>

      <a
        href="https://linkedin.com/in/piyushkumar0"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-3 px-6 py-4 rounded-xl border border-[var(--border)] text-[var(--text-secondary)] hover:border-accent-cyan/40 hover:text-accent-cyan hover:bg-accent-cyan/5 transition-all duration-200 group"
      >
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <div class="text-left">
          <div class="text-xs text-[var(--text-tertiary)] font-mono uppercase tracking-wider mb-0.5">LinkedIn</div>
          <div class="text-sm font-medium">piyushkumar0</div>
        </div>
      </a>
    </div>

  </div>
</section>
