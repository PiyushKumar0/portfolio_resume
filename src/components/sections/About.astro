---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import atariLogo from '/public/atari-logo.png';
import pimcoLogo from '/public/pimco-logo.png';
import geminiLogo from '/public/gemini-solutions-logo.jpeg';

const companies = [
  { name: 'Atari', logo: atariLogo },
  { name: 'PIMCO', logo: pimcoLogo },
  { name: 'Gemini Solutions', logo: geminiLogo },
];
---

<section id="about" class="py-24 bg-[var(--bg-alt)]">
  <div class="max-w-4xl mx-auto px-6">
    <div class="anim fade-up">
      <SectionHeading overline="ABOUT ME" title="Who I Am" />
    </div>

    <div class="anim fade-up" style="transition-delay: 100ms">
      <div class="space-y-4 text-[var(--text-secondary)] text-base leading-relaxed">
        <p>
          I'm a <strong class="text-[var(--text-primary)]">Senior Software Engineer</strong> at <strong class="text-accent-cyan">Atari Inc</strong>, working on video game archival infrastructure and enhancing user experience on one of the oldest video game database sites.
        </p>
        <p>
          Previously, I spent about 5 years at <strong class="text-[var(--text-primary)]">Gemini Solutions</strong> building critical market data systems for <strong class="text-[var(--text-primary)]">PIMCO</strong> - from async microservices and AI integrations to live data quality dashboards. My work is driven by a test-first mindset and a deep respect for system design.
        </p>
      </div>

      <!-- Location & availability -->
      <div class="flex flex-wrap gap-3 mt-6">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-secondary)]">
          Delhi, India
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm bg-green-500/10 border border-green-500/25 text-green-400">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          Open to Opportunities
        </span>
      </div>

      <!-- Company logos -->
      <div class="mt-10">
        <p class="text-xs font-mono text-[var(--text-tertiary)] uppercase tracking-wider mb-4">Companies & Clients</p>
        <div class="flex items-center gap-8">
          {companies.map(c => (
            <div class="company-logo">
              <Image src={c.logo} alt={c.name} class="h-16 md:h-20 w-auto object-contain" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

