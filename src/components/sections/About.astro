---
import SectionHeading from '../ui/SectionHeading.astro';

const stats = [
  { value: 5, suffix: '+', label: 'Years Exp.' },
  { value: 2, suffix: '',  label: 'Companies' },
  { value: 1, suffix: '',  label: 'Research Paper' },
];
---

<section id="about" class="py-24 bg-[var(--bg-alt)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Left: Photo -->
      <div class="flex flex-col items-center lg:items-start anim fade-left">
        <div class="relative w-72 h-72 md:w-80 md:h-80">
          <!-- Offset accent frame -->
          <div class="absolute -inset-2 rounded-2xl bg-gradient-to-br from-accent-cyan/30 to-accent-violet/30 blur-sm"></div>
          <div class="absolute -bottom-3 -right-3 w-full h-full rounded-2xl border border-accent-cyan/20"></div>
          <!-- Photo container -->
          <div class="relative w-full h-full rounded-2xl overflow-hidden border border-[var(--border)] bg-[var(--bg-surface)]">
            <img src="/avatar.png" alt="Piyush Kumar" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Location & availability -->
        <div class="flex flex-wrap gap-3 mt-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-secondary)]">
            📍 Delhi, India
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm bg-green-500/10 border border-green-500/25 text-green-400">
            <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
            Open to Opportunities
          </span>
        </div>
      </div>

      <!-- Right: Text -->
      <div class="anim fade-right">
        <SectionHeading overline="ABOUT ME" title="Who I Am" />

        <div class="space-y-4 text-[var(--text-secondary)] text-base leading-relaxed">
          <p>
            I'm a <strong class="text-[var(--text-primary)]">Senior Software Engineer</strong> with 5+ years of experience crafting high-performance Python backends, cloud-native microservices, and data pipelines that actually move the needle for businesses.
          </p>
          <p>
            At <strong class="text-accent-cyan">Atari Games</strong>, I work on video game archival infrastructure and enhancing user experience on one of the oldest video game archival sites. Before that, I spent 4+ years at <strong class="text-[var(--text-primary)]">Gemini Solutions</strong> building critical market data systems for <strong class="text-[var(--text-primary)]">PIMCO</strong>, one of the world's largest asset managers.
          </p>
          <p>
            My work is driven by a test-first mindset, a deep respect for system design, and a genuine passion for turning messy data pipelines into clean, observable, and fast infrastructure.
          </p>
          <p>
            Beyond code, I'm a published researcher, hackathon finalist, and a part time trekker.
          </p>
        </div>

        <!-- Mini stats -->
        <div class="grid grid-cols-3 gap-4 mt-8">
          {stats.map(s => (
            <div class="card p-4 text-center">
              <div class="font-display font-bold text-2xl text-accent-cyan" data-target={s.value} data-suffix={s.suffix}>
                {s.value}{s.suffix}
              </div>
              <div class="text-xs text-[var(--text-secondary)] mt-1 uppercase tracking-wider font-medium">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
