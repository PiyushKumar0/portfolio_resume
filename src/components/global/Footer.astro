---
const navLinks = [
  { href: '#about',        label: 'About' },
  { href: '#experience',   label: 'Experience' },
  { href: '#skills',       label: 'Skills' },
  { href: '#projects',     label: 'Projects' },
  { href: '#achievements', label: 'Achievements' },
  { href: '#contact',      label: 'Contact' },
];
const socials = [
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/piyushkumar0',
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'Email',
    href: 'mailto:k.piyushkumar98@gmail.com',
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  },
];
---

<footer class="bg-[var(--bg-surface)] border-t border-[var(--border)]">
  <!-- Gradient separator -->
  <div class="h-px bg-gradient-to-r from-transparent via-accent-cyan/40 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <!-- Row 1: Logo + Nav -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-10">
      <a href="#hero" class="flex items-center gap-3">
        <img src="/favicon.png" alt="Piyush Kumar" class="h-6 w-auto" />
        <span class="font-display font-semibold text-[var(--text-primary)]">Piyush Kumar</span>
      </a>
      <nav class="flex flex-wrap gap-x-6 gap-y-2">
        {navLinks.map(link => (
          <a href={link.href} class="text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Row 2: Socials -->
    <div class="flex items-center justify-center gap-4 mb-10">
      {socials.map(s => (
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          aria-label={s.label}
          class="w-10 h-10 rounded-full bg-[var(--bg-alt)] flex items-center justify-center text-[var(--text-secondary)] hover:text-accent-cyan hover:bg-accent-cyan/10 transition-all duration-200"
        >
          <Fragment set:html={s.icon} />
        </a>
      ))}
    </div>

    <!-- Row 3: Legal -->
    <div class="pt-6 border-t border-[var(--border)] text-center">
      <p class="text-xs text-[var(--text-tertiary)]">
        Built with <span class="text-accent-cyan">Astro</span> &amp; <span class="text-accent-cyan">Tailwind CSS</span>
        &nbsp;·&nbsp;
        © {new Date().getFullYear()} Piyush Kumar
        &nbsp;·&nbsp;
        Designed &amp; Developed by Piyush Kumar
      </p>
    </div>
  </div>
</footer>
