---
interface Props {
  text: string;
  variant?: 'skill' | 'achievement' | 'company' | 'category' | 'highlight';
  class?: string;
}
const { text, variant = 'skill', class: className = '' } = Astro.props;

const variantClasses = {
  skill:       'bg-accent-cyan/10 border-accent-cyan/25 text-accent-cyan font-mono',
  achievement: 'bg-accent-violet/10 border-accent-violet/25 text-purple-400',
  company:     'bg-[var(--bg-alt)] border-[var(--border)] text-[var(--text-secondary)]',
  category:    'bg-accent-teal/10 border-accent-teal/25 text-accent-teal',
  highlight:   'bg-gradient-to-r from-accent-cyan/10 to-accent-violet/10 border-accent-cyan/20 text-accent-cyan',
};
---

<span
  class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium border transition-all ${variantClasses[variant]} ${className}`}
>
  {text}
</span>
