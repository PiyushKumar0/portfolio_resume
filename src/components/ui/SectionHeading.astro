---
interface Props {
  overline: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { overline, title, subtitle, align = 'left', class: className = '' } = Astro.props;
const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<div class={`flex flex-col ${alignClass} mb-12 ${className}`}>
  <p class="section-overline">{overline}</p>
  <h2 class="font-display font-bold text-3xl md:text-4xl text-[var(--text-primary)] leading-tight">
    {title}
  </h2>
  <!-- Gradient underline -->
  <div class="h-1 w-12 rounded-full bg-gradient-to-r from-accent-cyan to-accent-violet mt-4"></div>
  {subtitle && (
    <p class="mt-4 text-[var(--text-secondary)] text-lg max-w-2xl leading-relaxed">{subtitle}</p>
  )}
</div>
